{
  "name": "obsidian-desktop-home",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "check:css": "node scripts/check-css.cjs src/home.css",
    "test": "vitest run",
    "build": "npm run typecheck && node scripts/build.mjs",
    "build:preview": "vite build",
    "check": "npm run verify",
    "verify": "npm run typecheck && npm run lint && npm run check:css && npm run test && node scripts/build.mjs && npm run build:preview"
  },
  "dependencies": {
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "doiuse": "^6.0.6",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jsdom": "^26.0.0",
    "obsidian": "^1.14.4",
    "postcss": "^8.5.30",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  },
  "description": "A personal desktop homepage for Obsidian: wallpaper, clock, search, weather, calendar, tasks and notes widgets.",
  "author": "Shovy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FengBuL/obsidian-desktop-home.git"
  }
}
